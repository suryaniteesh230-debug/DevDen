# Build-time frontend configuration
VITE_API_BASE_URL=/
PORT=8000

# Backend runtime configuration
NEUROBOTS_ENVIRONMENT=production
NEUROBOTS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEUROBOTS_AUTH_SECRET_KEY=GENERATE_WITH_OPENSSL_RAND_HEX_32
NEUROBOTS_AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=480
NEUROBOTS_CORS_ORIGINS=[]

# Required only if Vercel has not automatically enrolled the project in Large Functions.
VERCEL_SUPPORT_LARGE_FUNCTIONS=1

# Optional Gemini-backed reasoning and speech
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_RETRIES=2
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_THINKING_BUDGET=0
GEMINI_SPEECH_MODEL=gemini-3.6-flash
