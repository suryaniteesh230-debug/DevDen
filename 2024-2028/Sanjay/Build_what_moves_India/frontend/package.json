{
  "name": "sahayi-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node tools/copy-ocr-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "prebuild": "node tools/copy-ocr-assets.mjs",
    "build": "npm run typecheck && vite build",
    "lint": "oxlint",
    "ocr:assets": "node tools/copy-ocr-assets.mjs",
    "ocr:check": "node tools/copy-ocr-assets.mjs --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/hin": "1.0.0",
    "@tesseract.js-data/mal": "1.0.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^27.4.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
