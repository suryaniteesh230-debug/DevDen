# Public development origin permitted by backend CORS (no trailing slash)
SAHAYI_DEV_FRONTEND_ORIGIN=http://127.0.0.1:5173

# Optional frontend development API base URL
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Kiosk inactivity clearing (server exposes only these bounded public durations)
SAHAYI_KIOSK_INACTIVITY_SECONDS=300
SAHAYI_KIOSK_WARNING_SECONDS=30

# Optional server-only agent configuration. Never use a real key in this file.
GROQ_API_KEY=replace-in-secret-manager
SAHAYI_AGENT_ENABLED=false
SAHAYI_AGENT_PROVIDER=groq
SAHAYI_AGENT_MODEL=openai/gpt-oss-120b
SAHAYI_AGENT_TIMEOUT_SECONDS=8
SAHAYI_AGENT_MAX_OUTPUT_TOKENS=700
SAHAYI_AGENT_MAX_TOOL_CALLS=6
SAHAYI_AGENT_MAX_ROUNDS=3
SAHAYI_AGENT_CONCURRENCY=4
SAHAYI_AGENT_REQUEST_BUDGET=200
SAHAYI_AGENT_RATE_LIMIT=6
SAHAYI_AGENT_RATE_WINDOW_SECONDS=60
